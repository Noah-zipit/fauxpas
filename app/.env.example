# Qloo API key (hackathon). When set, fauxpas queries the live Qloo Taste Graph.
# When unset, the app runs on built-in mock cultural data — perfect for development.
# Hackathon base URL per the official starter kit:
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# Optional: Groq key (your own API) for LLM-polished report narratives.
# When unset, narratives are generated from templates. No Muse quota touched.
GROQ_API_KEY=
